// Windows version resource: fills the file Properties dialog (Details tab).
// Version numbers must match [package] version in Cargo.toml.

1 VERSIONINFO
FILEVERSION     1,6,5,0
PRODUCTVERSION  1,6,5,0
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "westercoder"
      VALUE "FileDescription",  "srtstripper - strip non-alphabetic lines from SRT/text files"
      VALUE "FileVersion",      "1.6.5.0"
      VALUE "InternalName",     "srtstripper"
      VALUE "LegalCopyright",   "Copyright (c) 2026 westercoder (MIT License)"
      VALUE "OriginalFilename", "srtstripper.exe"
      VALUE "ProductName",      "srtstripper"
      VALUE "ProductVersion",   "1.6.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 0x4b0
  END
END
